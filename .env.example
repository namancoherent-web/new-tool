# DeepSeek is the only paid API used by this tool.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Brave Search API -- free tier (2000 queries/month), sign up at
# https://brave.com/search/api/. Primary discovery source: unlike scraping
# DuckDuckGo/Bing's HTML pages (which trigger anti-bot blocks under sustained
# use), this is a real API with an actual search index.
BRAVE_API_KEY=

# Google AI Mode discovery -- opens a real (visible) Chromium browser per
# query via Selenium and asks Google AI Mode for the broadest possible
# company list. Off by default (slow, opens a visible window). Requires
# Chromium installed and the persistent chrome_profile/ folder set up.
# Headless mode triggers Google's reCAPTCHA wall instantly -- keep this false.
GOOGLE_AI_MODE_ENABLED=true
GOOGLE_AI_MODE_HEADLESS=false
# When true (current default), AI Mode is the ONLY discovery source -- no
# DDG/Wikipedia/Wikidata/directory-mining, since those free sources are
# unreliable under sustained use. Discovery runs in parallel rounds of 3
# concurrent browser sessions, up to 12 attempts total, stopping once 200+
# unique companies are found (see pipeline/google_ai_mode_discovery.py).
GOOGLE_AI_MODE_ONLY=true
# Legacy setting, unused by the current parallel-round discovery logic --
# kept for backwards compatibility with older configs.
GOOGLE_AI_MODE_MAX_QUERIES=22
# How many real Chromium windows can be open at once during discovery and
# verification. Each one is a full browser process -- default of 2 is safe
# for low-spec laptops (older i3, 8GB RAM), keeping the machine usable
# during a run at the cost of longer total run time (more sequential
# rounds needed). On a faster machine with more RAM, raise this (e.g. 4-6)
# for meaningfully quicker runs.
GOOGLE_AI_MODE_MAX_PARALLEL_BROWSERS=2

# Pipeline tuning
MAX_CONCURRENT_CRAWLS=10
MAX_CONCURRENT_CLASSIFICATIONS=8
HTTP_TIMEOUT_SECONDS=15
PLAYWRIGHT_TIMEOUT_SECONDS=25
MIN_VERIFICATION_CONFIDENCE=40
DISCOVERY_TARGET_COMPANIES=200
DISCOVERY_MAX_WIDEN_ROUNDS=4

# Web UI (Phase 4) admin allowlist, comma-separated emails
ADMIN_EMAILS=
